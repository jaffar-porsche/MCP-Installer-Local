/>\n</p-link-tile>\n<p-link-tile\n  href=\"https://porsche.com\"\n  label=\"Some label\"\n  description=\"Some Description\"\n  background=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-link-tile>\n<p-link-tile\n  href=\"https://porsche.com\"\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"true\"\n  background=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-link-tile>\n<p-link-tile\n  href=\"https://porsche.com\"\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-link-tile>\n<p-link-tile\n  href=\"https://porsche.com\"\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"true\"\n  align=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-link-tile>\n<p-link-tile\n  href=\"https://porsche.com\"\n  label=\"Some label\"\n  description=\"An extra&shy;ordinarily Porsche\"\n  compact=\"true\"\n  size=\"inherit\" \n  style=\"Some contentfont-size: 45px;\"\n>\n  <img src=\"Some content\" Some content />\n</p-link-tile>\n<p-link-tile\n    aspect-ratio=\"4/3\"\n    href=\"#\"\n    label=\"Some Label\"\n    size=\"large\"\n    description=\"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum.\"\n  >\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">4/3</p-tag>\n<p-link-tile aspect-ratio=\"4/3\" href=\"#\" label=\"Some Label\" description=\"Some description\">\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">4/3</p-tag>\n<p-link-tile aspect-ratio=\"1/1\" href=\"#\" label=\"Some Label\" description=\"Some description\">\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">1/1</p-tag>\n<p-link-tile aspect-ratio=\"9/