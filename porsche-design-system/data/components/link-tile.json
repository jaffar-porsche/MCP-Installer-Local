        "defaultValue": null,
        "description": "Add ARIA attributes.",
        "isAria": true,
        "type": "LinkTileAriaAttribute"
      },
      "aspectRatio": {
        "allowedValues": [
          "1/1",
          "4/3",
          "3/4",
