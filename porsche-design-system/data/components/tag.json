{
  "name": "Tag",
  "id": "p-tag",
  "description": "`p-tag` is used to label, categorize, or organize items by using keywords that describe them.",
  "code": "<p-tag color=\"Some content\">Color Some contentSome content</p-tag>\n<p-tag icon=\"car\">Some label</p-tag>\n<p-tag icon-source=\"Some content\">Some label</p-tag>\n<p-tagSome content color=\"Some content\">\n  <button type=\"button\">Color Some contentSome content</button>\n</p-tag>\n<p-tagSome content color=\"Some content\">\n  <a href=\"https://porsche.com\">Color Some contentSome content</a>\n</p-tag>\n<p-tag icon=\"car\">\n  <button type=\"button\" aria-label=\"More information about used cars\">Used cars</button>\n</p-tag>\n<p-tag icon=\"car\">\n  <a href=\"https://porsche.com\" aria-label=\"More information about used cars\">Used cars</a>\n</p-tag>\n<p-tag compact=\"true\">Some label</p-tag>\n<p-tag compact=\"true\" icon=\"car\">Some label</p-tag>\n<p-tag compact=\"true\" icon=\"car\">\n  <a href=\"#\">Some anchor</a>\n</p-tag>\n<p-tag compact=\"true\">\n  <a href=\"#\">Some anchor</a>\n</p-tag>\n<p-tag compact=\"true\" icon=\"car\">\n  <button>Some button</button>\n</p-tag>\n<p-tag compact=\"true\">\n  <button>Some button</button>\n</p-tag>\n<p-tag color=\"notification-success-soft\" style=\"white-space: normal\">Some label with longer text wrapped in a narrow container</p-tag>",
