{
  "name": "Inline Notification",
  "id": "p-inline-notification",
  "description": "The `p-inline-notification` is a controlled component that provides action-based feedback messages (e.g. after\nperforming a task) or to convey informational and/or critical notification like some site related topics.",
  "code": "<p-inline-notification :theme=\"theme\" :heading=\"defaultHeading\" heading-tag=\"h4\" :description=\"defaultDescription\"></p-inline-notification>\n<p-inline-notification\n    id=\"bannerAction\"\n    :theme=\"theme\"\n    :heading=\"defaultHeading\"\n    heading-tag=\"h4\"\n    :description=\"defaultDescription\"\n    action-label=\"Retry\"\n    action-icon=\"reset\"\n  ></p-inline-notification>\n<p-inline-notification heading=\"Some content\" heading-tag=\"h3\" description=\"Some content\">\n</p-inline-notification>\n<p-inline-notification heading=\"Some content\" heading-tag=\"h3\" description=\"Some content\" state=\"Some content\">\n</p-inline-notification>\n<p-inline-notification heading=\"Some content\" heading-tag=\"h3\" description=\"Some content\" dismiss-button=\"false\">\n</p-inline-notification>\n<p-inline-notification>\n  <h3 slot=\"heading\">Some content</h3>\n  Some content\n</p-inline-notification>",
