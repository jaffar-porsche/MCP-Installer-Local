        "defaultValue": null,
        "description": "The min length of the password input.",
        "type": "number"
      },
      "name": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "The name of the password input.",
        "isRequired": true,
        "propOptions": {
          "reflect": true
        },
        "type": "string"
      },
      "placeholder": {
        "allowedValues": "string",
        "defaultValue": "",
        "description": "The placeholder text.",
        "type": "string"
      },
