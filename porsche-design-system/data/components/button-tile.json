{
  "name": "Button Tile",
  "id": "p-button tile",
  "description": "The `p-button-tile` is an interactive component that displays a provided image to tease content and performs form or\n**interaction** events within one container. Whenever you want to provide navigational elements, stick to the\n[Link Tile](components/link-tile) component instead.",
  "code": "<p-button-tile\n    label=\"Some label\"\n    description=\"Some Description\"\n  >\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">Some tag</p-tag>\n<p-button-tile\n    label=\"Some label\"\n    description=\"Some Description\"\n  >\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">Some tag</p-tag>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" Some content>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" size=\"Some content\" compact=\"true\" Some content>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" aspect-ratio=\"Some content\">\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" size=\"Some content\" style=\"font-size: 40px;\">\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" size=\"Some content\" compact=\"true\" style=\"font-size: 40px;\">\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" weight=\"Some content\">\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile label=\"Some Label\" description=\"Some Description\" weight=\"Some content\" compact=\"true\">\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"Some Description\"\n  gradient=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"true\"\n  gradient=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"Some Description\"\n  background=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"true\"\n  background=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"Some Description\"\n  compact=\"true\"\n  align=\"Some content\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n  label=\"Some label\"\n  description=\"An extra&shy;ordinarily Porsche\"\n  compact=\"true\"\n  size=\"inherit\" \n  style=\"Some contentfont-size: 45px;\"\n>\n  <img src=\"Some content\" Some content />\n</p-button-tile>\n<p-button-tile\n    aspect-ratio=\"4/3\"\n    label=\"Some Label\"\n    size=\"large\"\n    description=\"Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum.\"\n  >\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">4/3</p-tag>\n<p-button-tile aspect-ratio=\"4/3\" label=\"Some Label\" description=\"Some description\">\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">4/3</p-tag>\n<p-button-tile aspect-ratio=\"1/1\" label=\"Some Label\" description=\"Some description\">\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">1/1</p-tag>\n<p-button-tile aspect-ratio=\"9/16\" label=\"Some Label\" description=\"Some description\">\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">9/16</p-tag>\n<p-button-tile aspect-ratio=\"1/1\" label=\"Some Label\" description=\"Some description\">\n    <p-tag slot=\"header\" theme=\"dark\" color=\"background-frosted\" compact=\"true\">1/1</p-tag>",
