{
  "name": "Drilldown",
  "id": "p-drilldown",
  "description": "The `p-drilldown` component is meant for displaying an infinite multilevel structure in a drilldown menu that overlays\nthe page content from the start side of the screen. It is a controlled component that gives you flexible control over\nits behavior.",
  "code": "",
  "properties": {
    "controlledMeta": [
      {
        "event": "dismiss",
        "props": [
          "open"
        ]
      },
      {
        "event": "update",
        "props": [
          "activeIdentifier"
        ]
      }
    ],
    "eventsMeta": {
      "dismiss": {
        "description": "Emitted when the component requests to be dismissed.",
        "type": "void"
      },
      "update": {
        "description": "Emitted when activeIdentifier is changed.",
        "type": "DrilldownUpdateEventDetail",
        "typeDetail": "{ activeIdentifier: string | undefined }"
      }
    },
    "hasAriaProp": true,
    "hasElementInternals": false,
    "hasEvent": true,
    "hasObserveAttributes": false,
    "hasObserveChildren": false,
    "hasSlot": true,
    "isChunked": true,
    "isDelegatingFocus": false,
    "isExperimental": true,
    "isInternal": false,
    "isThemeable": true,
    "nestedComponents": [
      "p-button-pure",
      "p-button"
    ],
    "propsMeta": {
      "activeIdentifier": {
        "allowedValues": "string",
        "defaultValue": null,
        "description": "Defines which drilldown-item to be visualized as opened.",
        "type": "string | undefined"
      },
      "aria": {
        "allowedValues": {
          "aria-label": "string"
        },
        "defaultValue": null,
        "description": "Add ARIA attributes.",
        "isAria": true,
        "type": "DrilldownAriaAttribute"
      },
      "open": {
        "allowedValues": "boolean",
        "defaultValue": false,
        "description": "If true, the drilldown is visualized as opened.",
        "type": "boolean"
      },
      "theme": {
        "allowedValues": [
          "light",
          "dark",
          "auto"
        ],
        "defaultValue": "light",
        "description": "Adapts the drilldown color depending on the theme.",
        "type": "Theme"
      }
    },
    "slotsMeta": {
      "": {
        "description": "Default slot to render p-drilldown items."
      }
    },
    "styling": "jss"
  }
}