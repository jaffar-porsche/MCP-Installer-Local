# Create your PAT at: https://cicd.skyway.porsche.com/-/user_settings/personal_access_tokens
# Required scope: api
GITLAB_TOKEN=your_gitlab_personal_access_token_here
GITLAB_BASE_URL=https://cicd.skyway.porsche.com

# Proxy Settings (optional - only needed if behind corporate firewall)
HTTP_PROXY=http://http-proxy.porsche.org:3128
HTTPS_PROXY=http://http-proxy.porsche.org:3133

# MCP Server Port
MCP_PORT=8003