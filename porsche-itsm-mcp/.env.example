# Environment variables for Porsche ITSM MCP Server
# Copy this file to .env and fill in your actual values

# Entra ID authentication
ENTRA_CLIENT_ID=your-entra-client-id
ENTRA_CLIENT_SECRET=your-entra-client-secret

# Porsche API configuration
API_BASE_URL=https://eu-1.test.api.porsche.io/porsche-group/test

# ITSM credentials (required for read operations)
ITSM_USER=your-itsm-username
ITSM_PASSWORD=your-itsm-password
