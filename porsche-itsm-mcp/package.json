{
  "name": "porsche-itsm-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Porsche ITSM (IT Service Management) APIs",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start:stdio": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "validate": "npm run build && node validate.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "keywords": ["mcp", "porsche", "itsm", "incident", "api"],
  "author": "Porsche AG",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
