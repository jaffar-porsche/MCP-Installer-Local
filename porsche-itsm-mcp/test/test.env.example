# Test Environment Variables Template
# Copy this file to test.env and modify values as needed for testing
# These values are automatically loaded by Jest and override any existing env vars during tests

# Entra ID test credentials (use test/mock values)
ENTRA_CLIENT_ID=test-entra-client-id
ENTRA_CLIENT_SECRET=test-entra-client-secret

# Porsche API test configuration 
API_BASE_URL=https://test-api.example.com

# ITSM test credentials
ITSM_USER=test-itsm-user
ITSM_PASSWORD=test-itsm-password

# Note: For integration tests, you can put real credentials here
# But for unit tests, these mock values are sufficient
